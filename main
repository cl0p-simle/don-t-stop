local function pointPosition(point)
    return Vector3.new(point[2], point[3], point[4])
end

-- Find the two recorded samples surrounding the requested source time.
local function findSegment(sourceTime)
    local low, high = 1, #PATH - 1
    while low <= high do
        local mid = math.floor((low + high) / 2)
        if PATH[mid + 1][1] < sourceTime then
            low = mid + 1
        elseif PATH[mid][1] > sourceTime then
            high = mid - 1
        else
            return mid
        end
    end
    return math.clamp(low, 1, #PATH - 1)
end

-- Minimal single-button ON/OFF control.
local playerGui = player:WaitForChild("PlayerGui")
local oldGui = playerGui:FindFirstChild("RouteReplay51sLoopUI")
if oldGui then
    oldGui:Destroy()
end

local gui = Instance.new("ScreenGui")
gui.Name = "RouteReplay51sLoopUI"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local toggle = Instance.new("TextButton")
toggle.Name = "Toggle"
toggle.Size = UDim2.fromOffset(76, 30)
toggle.Position = UDim2.new(1, -22, 1, -22)
toggle.AnchorPoint = Vector2.new(1, 1)
toggle.BackgroundColor3 = Color3.fromRGB(62, 66, 73)
toggle.BorderSizePixel = 0
toggle.AutoButtonColor = false
toggle.Font = Enum.Font.GothamMedium
toggle.Text = "OFF"
toggle.TextColor3 = Color3.fromRGB(245, 246, 248)
toggle.TextSize = 12
toggle.Parent = gui

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(1, 0)
toggleCorner.Parent = toggle

local toggleStroke = Instance.new("UIStroke")
toggleStroke.Color = Color3.fromRGB(91, 96, 105)
toggleStroke.Thickness = 1
toggleStroke.Transparency = 0.25
toggleStroke.Parent = toggle

local isRunning = false
local workerActive = false
local runToken = 0

local function updateUI()
    if isRunning then
        toggle.Text = "ON"
        toggle.BackgroundColor3 = Color3.fromRGB(48, 132, 88)
        toggleStroke.Color = Color3.fromRGB(77, 170, 116)
    else
        toggle.Text = "OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(62, 66, 73)
        toggleStroke.Color = Color3.fromRGB(91, 96, 105)
    end
end

-- StartRun is expected to be a RemoteEvent somewhere under ReplicatedStorage
-- (for example ReplicatedStorage.Remotes.StartRun) in an experience you own
-- or are authorized to test.
local function findStartRunRemote()
    for _, candidate in ipairs(ReplicatedStorage:GetDescendants()) do
        if candidate.Name == "StartRun" and candidate:IsA("RemoteEvent") then
            return candidate
        end
    end
    return nil
end

local function playOneLap(token)
    local character = player.Character
    if not character then
        character = player.CharacterAdded:Wait()
    end

    if not isRunning or token ~= runToken then
        return false, "stopped"
    end

    local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then
        return false, "캐릭터를 찾을 수 없음"
    end

    local previousAutoRotate = humanoid.AutoRotate
    humanoid.AutoRotate = false
    local savedRotation = root.CFrame.Rotation
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.new(pointPosition(PATH[1])) * savedRotation

    local startedAt = os.clock()
    local lastUiUpdate = 0
    local ok, err = pcall(function()
        while isRunning and token == runToken do
            if not root.Parent or not humanoid.Parent or humanoid.Health <= 0 then
                error("캐릭터가 사라졌거나 쓰러졌습니다")
            end

            local elapsed = os.clock() - startedAt
            local progress = math.clamp(elapsed / TARGET_DURATION, 0, 1)

            if elapsed >= TARGET_DURATION then
                root.CFrame = CFrame.new(pointPosition(PATH[#PATH])) * savedRotation
                return
            end

            local sourceTime = progress * SOURCE_DURATION
            local index = findSegment(sourceTime)
            local a = PATH[index]
            local b = PATH[index + 1]
            local span = b[1] - a[1]
            local alpha = if span > 0 then math.clamp((sourceTime - a[1]) / span, 0, 1) else 0
            local position = pointPosition(a):Lerp(pointPosition(b), alpha)
            root.CFrame = CFrame.new(position) * savedRotation

            if elapsed - lastUiUpdate >= 0.12 then
                updateUI(progress)
                lastUiUpdate = elapsed
            end

            RunService.Heartbeat:Wait()
        end
    end)

    if humanoid.Parent then
        humanoid.AutoRotate = previousAutoRotate
    end

    if not ok then
        warn("[RouteReplay] " .. tostring(err))
        return false, tostring(err)
    end

    return isRunning and token == runToken, "stopped"
end

local function runLoop(token)
    workerActive = true

    while isRunning and token == runToken do
        local completed, reason = playOneLap(token)
        if not completed then
            if reason ~= "stopped" then
                isRunning = false
                updateUI(0, reason or "재생을 중단했습니다")
            end
            break
        end

        if not isRunning or token ~= runToken then
            break
        end

        local remote = findStartRunRemote()
        if not remote then
            isRunning = false
            updateUI(0, "StartRun RemoteEvent를 찾을 수 없음")
            warn("[RouteReplay] ReplicatedStorage 아래에서 StartRun RemoteEvent를 찾지 못했습니다.")
            break
        end

        local fired, fireError = pcall(function()
            remote:FireServer()
        end)
        if not fired then
            isRunning = false
            updateUI(0, "StartRun 호출 실패")
            warn("[RouteReplay] StartRun 호출 실패: " .. tostring(fireError))
            break
        end

        updateUI()
        -- No extra wait: the next 51-second lap starts immediately after FireServer.
    end

    workerActive = false
    if not isRunning then
        updateUI()
    end
end

local function toggleLoop()
    if isRunning then
        isRunning = false
        runToken += 1
        updateUI()
        return
    end

    if workerActive then
        return
    end

    local remote = findStartRunRemote()
    if not remote then
        updateUI(0, "StartRun RemoteEvent를 찾을 수 없음")
        warn("[RouteReplay] ReplicatedStorage 아래에서 StartRun RemoteEvent를 찾지 못했습니다.")
        return
    end

    runToken += 1
    local token = runToken
    isRunning = true
    updateUI(0, "반복 재생 준비 중")
    task.spawn(runLoop, token)
end

toggle.Activated:Connect(toggleLoop)

updateUI()

-- ============================================================
-- 추가: P키 토글 + 20분 AFK 튕김 방지
-- 원본 로직은 그대로, 아래만 추가됨
-- ============================================================
local UserInputService = game:GetService("UserInputService")
local VirtualUser      = game:GetService("VirtualUser")

-- P키로 ON/OFF
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.P then
        toggleLoop()
    end
end)

-- Idled 시그널 무력화 (20분 AFK 킥 방지)
pcall(function()
    if getconnection then
        for i = 1, 5 do
            local c = getconnection(player.Idled, i)
            if c then c:Disable() end
        end
    end
end)

-- isRunning 동안 주기적 가짜 입력 발사
task.spawn(function()
    while true do
        if isRunning then
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new(0, 0))
            end)
        end
        task.wait(55)
    end
end)
